# Copy to .env (gitignored) and fill in. Never commit real values.

# Amazon Bedrock (Claude). CLAUDE_AWS_MODEL and CLAUDE_AWS_FAST_MODEL take a model ID, an inference profile ID or an ARN
# (we use application inference profile ARNs). Only the access key, secret and region are read: no session token or SSO.
# All values may stay empty: fixtures, Teach (offline template proposer), Rule, Evidence and the tests still work.
CLAUDE_AWS_ACCESS_KEY=
CLAUDE_AWS_SECRET_KEY=
CLAUDE_AWS_REGION=
CLAUDE_AWS_MODEL=          # strong: sketch proposal, escalation, zero-shot baseline
CLAUDE_AWS_MODEL_ALIAS=
CLAUDE_AWS_FAST_MODEL=     # fast: per-clip perception

# Ring — Developer Playground token (30 min) or OAuth app credentials (optional; the token is normally pasted in the UI)
RING_PLAYGROUND_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_WEBHOOK_SIGNING_KEY=  # HMAC signing key from the app credentials (not the client secret)

OPENAI_API_KEY=            # optional (demo-video narration)

    "@types/node": "24.19.2",
    "@types/react": "18.2.46",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.16",
    "esbuild": "0.28.2",
    "playwright-core": "^1.64.1",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.0",
